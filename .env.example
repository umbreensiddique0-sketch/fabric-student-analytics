# ---------------------------------------------------------------------------
# Student Analytics Lakehouse - environment configuration template.
# Copy this file to ".env" and adjust values as needed. ".env" is gitignored.
# ---------------------------------------------------------------------------

# Fixed "today" used for all overdue / snapshot calculations (YYYY-MM-DD).
# The pipeline and tests rely on this being stable so results are reproducible.
REFERENCE_DATE=2025-06-30

# Seed for deterministic synthetic data generation.
RANDOM_SEED=42

# Toggle data-masking in the security/governance layer (bonus step).
# true  -> apply PII masking to analytical outputs
# false -> leave raw values in place
ENABLE_MASKING=true
